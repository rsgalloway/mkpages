  <rect width="1200" height="630" fill="url(#bg)"/>
  <rect width="1200" height="630" fill="url(#glow)"/>
  <rect x="34" y="44" width="1132" height="542" rx="26" fill="rgba(18, 24, 34, 0.94)" stroke="#2d3748" stroke-width="2"/>
