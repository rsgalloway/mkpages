<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% if page.title %}{{ page.title }} | {% endif %}{{ site.title }}</title>
    <meta name="description" content="{{ site.description }}">
    <link rel="stylesheet" href="{{ '/assets/site.css' | relative_url }}">
    <script type="module">
      import mermaid from "https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs";

      mermaid.initialize({ startOnLoad: false });

      function startMatrixRain(canvas) {
        const context = canvas.getContext("2d");
        if (!context) {
          return;
        }

        const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
        const glyphs = "アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲン0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const fontSize = 18;
        let columns = 0;
        let drops = [];
        let animationFrameId = 0;
        let lastFrame = 0;

        const resize = () => {
          const scale = window.devicePixelRatio || 1;
          const width = window.innerWidth;
          const height = window.innerHeight;
          canvas.width = Math.floor(width * scale);
          canvas.height = Math.floor(height * scale);
          canvas.style.width = `${width}px`;
          canvas.style.height = `${height}px`;
          context.setTransform(scale, 0, 0, scale, 0, 0);
          columns = Math.max(1, Math.floor(width / fontSize));
          drops = Array.from({ length: columns }, () => Math.random() * -40);
        };

        const draw = (timestamp) => {
          if (motionQuery.matches) {
            context.clearRect(0, 0, canvas.width, canvas.height);
            return;
          }
          if (timestamp - lastFrame < 48) {
            animationFrameId = window.requestAnimationFrame(draw);
            return;
          }
          lastFrame = timestamp;

          context.fillStyle = "rgba(1, 4, 2, 0.12)";
          context.fillRect(0, 0, canvas.width, canvas.height);
          context.font = `${fontSize}px "IBM Plex Mono", monospace`;
          context.textBaseline = "top";

          for (let index = 0; index < columns; index += 1) {
            const glyph = glyphs[Math.floor(Math.random() * glyphs.length)];
            const x = index * fontSize;
            const y = drops[index] * fontSize;
            context.fillStyle = "rgba(98, 255, 150, 0.78)";
            context.fillText(glyph, x, y);
            context.fillStyle = "rgba(200, 255, 220, 0.96)";
            context.fillText(glyph, x, y - fontSize * 0.18);

            if (y > window.innerHeight && Math.random() > 0.975) {
              drops[index] = Math.random() * -24;
            } else {
              drops[index] += 1;
            }
          }

          animationFrameId = window.requestAnimationFrame(draw);
        };

        resize();
        context.fillStyle = "rgba(1, 4, 2, 1)";
        context.fillRect(0, 0, canvas.width, canvas.height);
        animationFrameId = window.requestAnimationFrame(draw);

        window.addEventListener("resize", resize, { passive: true });
        motionQuery.addEventListener("change", () => {
          if (motionQuery.matches) {
            window.cancelAnimationFrame(animationFrameId);
            context.clearRect(0, 0, canvas.width, canvas.height);
          } else {
            resize();
            lastFrame = 0;
            animationFrameId = window.requestAnimationFrame(draw);
          }
        });
      }

      document.addEventListener("DOMContentLoaded", async () => {
        const themeCanvas = document.getElementById("theme-canvas");
        const matrixEnabled =
          themeCanvas instanceof HTMLCanvasElement &&
          getComputedStyle(document.body).getPropertyValue("--matrix-rain").trim() === "on";
        if (matrixEnabled) {
          startMatrixRain(themeCanvas);
        } else if (themeCanvas) {
          themeCanvas.remove();
        }

        const mermaidBlocks = [];
        const mermaidCodeBlocks = document.querySelectorAll(".site-main pre");
        for (const block of mermaidCodeBlocks) {
          const languageContainer = block.closest("[class*='language-']");
          if (!languageContainer || !/\blanguage-mermaid\b/.test(languageContainer.className)) {
            continue;
          }

          const container = languageContainer.matches("div")
            ? languageContainer
            : block.parentElement;
          const diagram = document.createElement("pre");
          diagram.className = "mermaid";
          diagram.textContent = block.textContent ?? "";
          mermaidBlocks.push(diagram);
          container.replaceWith(diagram);
        }

        if (mermaidBlocks.length > 0) {
          await mermaid.run({ nodes: mermaidBlocks });
        }

        const headings = document.querySelectorAll(".site-main h1, .site-main h2, .site-main h3");
        for (const heading of headings) {
          if (!heading.id || heading.querySelector(".header-anchor")) {
            continue;
          }

          const anchor = document.createElement("a");
          anchor.className = "header-anchor";
          anchor.href = `#${encodeURIComponent(heading.id)}`;
          anchor.setAttribute("aria-label", `Link to section: ${heading.textContent.trim()}`);
          anchor.textContent = "#";
          heading.appendChild(anchor);
        }

        const codeBlocks = document.querySelectorAll(".site-main pre");
        for (const block of codeBlocks) {
          if (block.parentElement && block.parentElement.classList.contains("code-block")) {
            continue;
          }

          const wrapper = document.createElement("div");
          wrapper.className = "code-block";
          const languageContainer = block.closest("[class*='language-']");
          if (
            languageContainer &&
            /\blanguage-mermaid\b/.test(languageContainer.className)
          ) {
            continue;
          }
          if (
            languageContainer &&
            /(language-bash|language-shell|language-sh|language-console)/.test(
              languageContainer.className
            )
          ) {
            wrapper.classList.add("terminal");
          }
          block.parentNode.insertBefore(wrapper, block);
          wrapper.appendChild(block);

          const button = document.createElement("button");
          button.className = "copy-button";
          button.type = "button";
          button.setAttribute("aria-label", "Copy code to clipboard");
          button.title = "Copy code";
          button.innerHTML = `
            <svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M9 9h10v10H9z"></path>
              <path d="M5 5h10v2H7v8H5z"></path>
            </svg>
          `;
          wrapper.appendChild(button);

          button.addEventListener("click", async () => {
            const text = block.innerText;
            try {
              await navigator.clipboard.writeText(text);
              button.setAttribute("aria-label", "Copied");
              button.title = "Copied";
            } catch (error) {
              button.setAttribute("aria-label", "Press Ctrl+C to copy");
              button.title = "Press Ctrl+C to copy";
            }
            window.setTimeout(() => {
              button.setAttribute("aria-label", "Copy code to clipboard");
              button.title = "Copy code";
            }, 1400);
          });
        }
      });
    </script>
  </head>
  <body>
    <canvas id="theme-canvas" aria-hidden="true"></canvas>
    <div class="site-shell">
      {% include site_header.html %}
      <main class="site-main">{{ content }}</main>
      {% include site_footer.html %}
    </div>
  </body>
</html>
